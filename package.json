{
  "name": "saikat-das-portfolio",
  "version": "3.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.25",
      "next>sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-og-runtime-fonts.mjs",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "build": "next build",
    "auth:bootstrap": "node --no-warnings --env-file-if-exists=.env --experimental-strip-types scripts/bootstrap-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "content:seed": "node --no-warnings --env-file-if-exists=.env --experimental-strip-types scripts/seed-content.ts",
    "music:seed": "node --no-warnings --env-file-if-exists=.env --experimental-strip-types scripts/seed-music.ts",
    "photos:seed": "node --no-warnings --env-file-if-exists=.env --experimental-strip-types scripts/seed-photos.ts",
    "case-studies:seed": "node --no-warnings --env-file-if-exists=.env --experimental-strip-types scripts/seed-project-case-studies.ts",
    "resume:seed": "node --no-warnings --env-file-if-exists=.env --experimental-strip-types scripts/seed-resume.ts",
    "start": "next start",
    "test:security": "vitest run lib/security",
    "test:unit": "vitest run app components db lib --exclude='**/*.live.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.28",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@base-ui/react": "^1.6.0",
    "@blossom-carousel/react": "^1.5.2",
    "@cloudinary/url-gen": "^1.22.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.7.6",
    "ai": "^7.0.37",
    "beautiful-mermaid": "^1.1.3",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cuelume": "0.1.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "heic-decode": "^2.1.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.3.0",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "server-only": "^0.0.1",
    "shaders": "3.0.444",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "subset-font": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@next/playwright": "16.3.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/rss": "^0.0.32",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}

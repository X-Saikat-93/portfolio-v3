# Neon/Postgres runtime connection
DATABASE_URL=
# Used only by `pnpm db:migrate`; keep this credential out of production runtime.
MIGRATION_DATABASE_URL=

# Cloudinary delivery and owner-only signed uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_AVATAR_PUBLIC_ID=saikat-das/avatar
NEXT_PUBLIC_CLOUDINARY_AVATAR_VERSION=
NEXT_PUBLIC_CLOUDINARY_RESUME_PUBLIC_ID=saikat-das/resume
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=saikat-das

# Better Auth owner-only authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=
# Used only by `pnpm auth:bootstrap`; do not deploy this value.
ADMIN_PASSWORD=

# Admin mutation protection
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_MUTATION_RATE_LIMIT_MAX_REQUESTS=30
ADMIN_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# SMTP contact notifications; SMTP_FROM_EMAIL may equal SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Canonical public origin
PUBLIC_SITE_URL=https://xsaikat.vercel.app
